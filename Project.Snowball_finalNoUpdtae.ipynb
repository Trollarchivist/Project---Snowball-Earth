   "source": [
    "# Calculate ice thickness ( latitude dependent)\n",
    "\n",
    "\n",
    "def ice_thickness(T):\n",
    "    z = 2.5*(-2-T)/0.06 \n",
    "    z = np.maximum(0, z)\n",
    "    return z\n",
    "# test\n",
    "ice_thickness(-27)"
   ]
